{
  "name": "devs",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "start": "turbo run start",
    "test": "turbo run test",
    "format": "prettier --write .",
    "prepare": "husky",
    "registry:sync": "tsx --env-file=packages/db/.env scripts/sync-registry.ts",
    "registry:migrate-slugs": "tsx --env-file=packages/db/.env scripts/migrate-slugs.ts",
    "test:scripts": "tsx --test scripts/lib/catalog-graph.test.ts",
    "checks": "pnpm --filter @repo/ui checks && pnpm --filter web checks"
  },
  "lint-staged": {
    "*.{json,md,mdx,yml,yaml,css}": [
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "keywords": [],
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@repo/db": "workspace:*",
    "@types/node": "^25.9.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
