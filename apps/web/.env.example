# Copy to apps/web/.env. Both values are optional for working on components and docs.
# Public URL of the site, used for canonical links, the sitemap and OG images.
# Defaults to https://nachui.tech.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Base URL of apps/api. The docs chat assistant talks to it.
NEXT_PUBLIC_API_URL=http://localhost:3001
