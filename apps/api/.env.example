# Copy to apps/api/.env. The api refuses to boot when a required value is missing.

# Postgres with the pgvector extension (same database as packages/db).
POSTGRES_URL=postgres://user:password@localhost:5432/nachui

# Gemini key for the chat agent and query embeddings.
GOOGLE_GENERATIVE_AI_API_KEY=

# Comma separated origins allowed by CORS. http://localhost:3000 is always allowed.
FRONTEND_URLS=http://localhost:3000

# Optional.
# PORT=3001
# PORTFOLIO_URL=https://example.com

# NachUI Studio. Set all four to turn it on; leave them all out to keep it off.
# GitHub OAuth app callback: <API_URL>/api/v1/auth/github/callback
# STUDIO_URL=http://localhost:3002
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# STUDIO_SECRET=at-least-32-random-characters
# API_URL=http://localhost:3001
# STUDIO_DAILY_LIMIT=20
