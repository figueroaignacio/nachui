{
  "name": "storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-stories.mjs",
    "dev": "pnpm run generate && storybook dev -p 6006 --no-open",
    "build": "pnpm run generate && storybook build -o storybook-static",
    "lint": "eslint . --max-warnings 0",
    "check-types": "pnpm run generate && tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/ui": "workspace:*",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.2",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
