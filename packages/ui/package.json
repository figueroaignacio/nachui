{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./globals.css": "./src/css/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./layout/*": "./src/layout/*.tsx",
    "./ai/*": "./src/ai/*.tsx",
    "./icons/*": "./src/icons/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./registry": "./src/lib/registry.ts",
    "./src/demos/*/*": "./src/demos/*/*.tsx",
    "./src/bricks/*/*": "./src/bricks/*/*.tsx",
    "./src/*": "./src/*",
    "./tokens/*": "./tokens/*"
  },
  "typesVersions": {
    "*": {
      "src/demos/*/*": [
        "./src/demos/*/*.tsx"
      ],
      "src/bricks/*/*": [
        "./src/bricks/*/*.tsx"
      ],
      "src/*": [
        "./src/*"
      ]
    }
  },
  "scripts": {
    "generate:registry": "node scripts/generate-registry.mjs",
    "check:registry": "node scripts/generate-registry.mjs --check",
    "check:comments": "node scripts/check-no-comments.mjs",
    "checks": "pnpm run check:tokens && pnpm run check:registry && pnpm run check:comments && pnpm run check:logical",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --project unit",
    "test:run": "vitest run --project unit",
    "test:watch": "vitest --watch --project unit",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --project unit --coverage",
    "test:coverage:watch": "vitest --project unit --coverage",
    "check-types": "tsc --noEmit",
    "check:logical": "node scripts/check-logical-classes.mjs",
    "test:browser": "vitest run --project browser",
    "test:visual": "vitest run --project visual",
    "test:visual:update": "vitest run --project visual --update",
    "tokens": "node scripts/build-tokens.mjs",
    "check:tokens": "node scripts/build-tokens.mjs --check"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@turbo/gen": "^2.9.17",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "4.1.8",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vitest-browser-react": "^2.3.0"
  }
}
