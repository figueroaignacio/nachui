# Copy to packages/ai/.env for the RAG ingest (pnpm --filter @repo/ai ingest).
# The ingest also reads packages/db/.env (POSTGRES_URL) and apps/web/.env when they exist.

# Gemini key used to embed the docs.
GOOGLE_GENERATIVE_AI_API_KEY=

# Running web app whose /api/docs catalog gets ingested.
FRONTEND_URL=http://localhost:3000
